# Copie para .env e troque os valores. O .env NÃO vai para o GitHub.
DB_PASSWORD=troque-por-uma-senha-forte
CODIGO_CONVITE=troque-este-convite
# Porta publicada na VPS. Se usar Nginx na frente, prefira 127.0.0.1:8080
PORTA=8080
# Memória máxima do Java (VPS de 1 GB: -Xmx384m; 2 GB: -Xmx768m)
JAVA_OPTS=-Xmx384m
